# =============================================================================
# TramitaIA - Configuracion de ejemplo
# =============================================================================
# Copiar este archivo a ".env" y completar los valores.
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux / macOS:         cp .env.example .env
#
# IMPORTANTE: ".env" esta en .gitignore. Nunca versionar credenciales reales.
# Este archivo no contiene ninguna clave real.
# =============================================================================


# -----------------------------------------------------------------------------
# Aplicacion
# -----------------------------------------------------------------------------
APP_NAME=TramitaIA
LOG_LEVEL=INFO

# Directorio de la base SQLite (consultas, metricas, evaluaciones)
SQLITE_PATH=data/tramitaia.db

# Origenes permitidos para el frontend. Separados por coma.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000


# -----------------------------------------------------------------------------
# Proveedor de LLM
# -----------------------------------------------------------------------------
# Valores posibles:
#   openai_compatible    -> cualquier endpoint con API estilo OpenAI.
#                           Es la opcion principal del proyecto: permite usar
#                           modelos mas capaces y, ademas, expone las metricas
#                           de prompt caching que exige el experimento.
#   ollama               -> servidor local. Util para desarrollo, pero en esta
#                           maquina solo entra un modelo 1.5B, insuficiente para
#                           las reglas anti-alucinacion (ver docs/bitacora.md 1.2.3).
#   fake                 -> proveedor determinista sin red (solo para tests).
LLM_PROVIDER=openai_compatible

# --- Endpoint estilo OpenAI ---
# Groq es la opcion recomendada para este proyecto: plan gratuito de
# 1000 req/dia y 200k tokens/dia, y sobre todo reporta
# usage.prompt_tokens_details.cached_tokens, que es la metrica de prompt
# caching que el enunciado pide medir y que un servidor local no expone.
#   https://api.groq.com/openai/v1
#
# Alternativas validas, todas con API estilo OpenAI:
#   https://openrouter.ai/api/v1        (OpenRouter: 50 req/dia sin credito)
#   https://api.openai.com/v1           (OpenAI)
#   https://api.sambanova.ai/v1         (SambaNova)
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Pegar aqui la clave. Este archivo es una plantilla: la clave real va en .env,
# que esta en .gitignore y no se versiona.
OPENAI_API_KEY=

# Modelo a usar. Debe ser el MISMO para CAG y RAG, o la comparacion no vale.
# gpt-oss-120b es el recomendado: es uno de los dos unicos modelos de Groq
# que reportan tokens cacheados.
OPENAI_MODEL=openai/gpt-oss-120b

# Ventana de contexto real del modelo. El presupuesto de CAG se valida
# contra este valor. gpt-oss tiene 131072 tokens natively; verificar en la
# ficha del modelo.
OPENAI_CONTEXT_LENGTH=32768

# --- Ollama (usar solo con LLM_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b-instruct
OLLAMA_CONTEXT_LENGTH=4096

# --- Parametros de generacion ---
# 0.0 favorece respuestas deterministas: necesario para que el experimento
# CAG vs RAG sea reproducible.
LLM_TEMPERATURE=0.0
LLM_TOP_P=1.0
LLM_MAX_OUTPUT_TOKENS=1024
LLM_REQUEST_TIMEOUT_S=120
LLM_MAX_RETRIES=2

# --- Prompt caching del proveedor ---
# Solo puede activarse si el proveedor lo expone de forma documentada.
# Si el proveedor no reporta metricas de cache, se registra como no disponible.
# No se inventan valores de cache.
LLM_PROMPT_CACHING_ENABLED=false


# -----------------------------------------------------------------------------
# CAG - Cache-Augmented Generation
# -----------------------------------------------------------------------------
# Presupuesto de tokens para el contexto documental reutilizable.
# Debe quedar por debajo de la ventana del modelo menos la reserva para el
# prompt de sistema y la respuesta. La validacion de config.py lo rechaza si
# se pasa, pero conviene ajustarlo al corpus real una vez medida la Fase 4.
CAG_MAX_CONTEXT_TOKENS=6000

# Directorio de la cache de contexto preparado.
CAG_CACHE_DIR=data/processed/cag_cache

# Dividir el corpus en conjuntos tematicos cuando no entre completo.
CAG_ALLOW_PARTITIONING=true


# -----------------------------------------------------------------------------
# RAG - Retrieval-Augmented Generation
# -----------------------------------------------------------------------------
# Modelo de embeddings multilingue (espanol). Descargase en la primera ejecucion.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Parametros de fragmentacion (en caracteres).
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150

# Fragmentos recuperados por consulta.
RAG_TOP_K=5

# Indice vectorial persistente.
# Valores posibles: chroma | faiss
VECTOR_STORE=chroma
CHROMA_DIR=data/processed/chroma
FAISS_INDEX_PATH=data/processed/faiss/index.faiss


# -----------------------------------------------------------------------------
# Ingesta documental
# -----------------------------------------------------------------------------
# Corpus acotado a tramites concretos (no cargar toda la normativa provincial).
# Etiquetas de tramite usadas para particionar y para las citas.
CORPUS_TRAMITES=partidas
# Respetar robots.txt y politicas de acceso antes de descargar.
FETCH_RESPECT_ROBOTS=true
FETCH_USER_AGENT=TramitaIA/0.1 (proyecto academico; contacto: definir-email@ejemplo)
# Espera entre descargas, en segundos.
FETCH_DELAY_S=1.0